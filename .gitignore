# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node.js
# node_modules is the directory where npm/yarn/pnpm installs dependencies.
# It's large and should never be committed.
node_modules/

# Environment variables
# .env files contain sensitive configuration like database URLs, API keys, etc.
# This is CRITICAL for security.
.env
.env.* # Also ignore any variations like .env.development, .env.production, etc.

# Build directories
# These directories contain compiled or bundled code and should be generated locally.
# Common names include:
build/
dist/
out/
.next/ # For Next.js (if used in conjunction with MERN)
.cache/ # For Webpack or other build tools

# Log files
# Debug logs generated by npm or other tools.
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*

# OS and Editor specific files
# These are generated by operating systems or IDEs and are not part of the project.
.DS_Store # macOS
Thumbs.db # Windows
.vscode/ # VS Code settings (optional, sometimes useful to share)
.idea/ # JetBrains IDEs (optional)
*.sublime-project # Sublime Text
*.sublime-workspace # Sublime Text

# Test coverage reports
coverage/

# Temporary files
.tmp/

# Uploaded files (if your app handles file uploads and stores them locally)
# Adjust this based on where your app stores uploads.
uploads/

# Database files (if you're using a local database file like SQLite)
# Not common in MERN with MongoDB, but included for completeness.
*.sqlite
*.sqlite3

# Other potential sensitive files (adjust as needed)
# Avoid committing any files with passwords or secrets.
keys/ # If keys are stored in files (should ideally be in .env)
secrets/ # If secrets are stored in files (should ideally be in .env)

# Example: If you have a specific file you know should be ignored
# my_specific_config_with_secrets.json

# Add any other files or directories specific to your project that should not be tracked.
